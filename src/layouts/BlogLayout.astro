---
import Layout from './Layout.astro';

interface Props {
  title: string;
  description: string;
  category: string;
  slug: string;
  publishDate: string;
  readingTime: number;
}

const { title, description, category, slug, publishDate, readingTime } = Astro.props;

// "See it live" — hand-picked demo cameras per post (see blog-posts.ts).
// Resolved here so individual post files need no changes.
import { blogPosts } from '../data/blog-posts';
import { getCameraById } from '../data/cameras';
import { gitLastModifiedMap } from '../lib/git-dates.mjs';
const _post = blogPosts.find((p) => p.slug === slug);

// Real dateModified from the post file's own git history (each post is its own
// .astro file, so this is genuinely per-post). Clamped to never precede the
// stated publish date; falls back to publishDate — the previous placeholder
// value — when history can't see the file, so this only ever improves.
const _gitModified = gitLastModifiedMap().get(`src/pages/blog/${slug}.astro`);
const _published = `${publishDate}T00:00:00-10:00`;
const dateModified =
  _gitModified && new Date(_gitModified) > new Date(_published) ? _gitModified : _published;
const seeItLive = (_post?.relatedCameraIds || [])
  .map((id) => getCameraById(id))
  .filter((c): c is NonNullable<typeof c> => Boolean(c));
const displayDate = new Date(`${publishDate}T00:00:00Z`).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});

const siteUrl = (Astro.site ?? new URL('https://pro.portofcams.com/')).href;
const pageUrl = new URL(Astro.url.pathname, Astro.site ?? 'https://pro.portofcams.com').href;

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  image: new URL('/clips/lewers-waikiki.jpg', Astro.site ?? 'https://pro.portofcams.com').href,
  // Full ISO 8601 with the HST offset. Google's Rich Results Test flags a bare
  // date as an invalid datetime missing a timezone — same non-critical issue that
  // was caught on the camera pages' VideoObject uploadDate.
  datePublished: `${publishDate}T00:00:00-10:00`,
  dateModified,
  mainEntityOfPage: pageUrl,
  // "Team", not the bare brand name, and matching the visible byline below.
  // Google's March 2026 core update explicitly downweights content attributed to
  // generic profiles with no track record; this is the same fix already shipped on
  // the sister site portofcams.com (PR #30). Still Organization rather than Person
  // — "Port of Cams Team" is not an individual, and typing it as one would be a
  // fabrication. A real named author with credentials remains the deeper fix.
  author: {
    "@type": "Organization",
    name: "Port of Cams Team",
    url: siteUrl,
  },
  publisher: {
    "@type": "Organization",
    "@id": `${siteUrl}#organization`,
    name: "Port of Cams",
    url: siteUrl,
  },
};
---

<Layout title={`${title} | PortOfCams Pro`} description={description} activeNav="">
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <style>
    .blog-back {
      display: inline-block;
      font-size: 12px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--muted);
      margin-bottom: 28px;
      transition: color 0.3s;
    }

    .blog-back:hover {
      color: var(--gold);
    }

    .blog-hero {
      padding: 160px 48px 80px;
      max-width: 900px;
      margin: 0 auto;
    }

    .blog-label {
      font-family: 'DM Mono', monospace;
      font-size: 11px;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--gold);
      margin-bottom: 24px;
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .blog-label::after {
      content: '';
      width: 32px;
      height: 1px;
      background: var(--gold);
      opacity: 0.5;
    }

    .blog-hero h1 {
      font-family: 'Cormorant Garamond', serif;
      font-size: clamp(36px, 5vw, 60px);
      font-weight: 600;
      line-height: 1.1;
      letter-spacing: -0.02em;
      color: var(--white);
      margin-bottom: 20px;
    }

    .blog-meta {
      font-family: 'DM Mono', monospace;
      font-size: 12px;
      color: var(--muted);
      letter-spacing: 0.1em;
    }

    .blog-divider {
      max-width: 900px;
      margin: 0 auto 0;
      border: none;
      border-top: 1px solid var(--border);
    }

    .blog-body {
      max-width: 720px;
      margin: 0 auto;
      padding: 64px 48px 100px;
      font-size: 17px;
      line-height: 1.8;
      color: rgba(245,240,232,0.75);
    }

    .blog-body :global(h2) {
      font-family: 'Cormorant Garamond', serif;
      font-size: 28px;
      font-weight: 600;
      color: var(--white);
      margin: 52px 0 18px;
      letter-spacing: -0.01em;
      line-height: 1.2;
    }

    .blog-body :global(h3) {
      font-size: 17px;
      font-weight: 500;
      color: var(--white);
      margin: 32px 0 12px;
      letter-spacing: 0.02em;
    }

    .blog-body :global(p) {
      margin-bottom: 22px;
    }

    .blog-body :global(ul),
    .blog-body :global(ol) {
      margin: 0 0 22px 20px;
    }

    .blog-body :global(li) {
      margin-bottom: 10px;
    }

    .blog-body :global(strong) {
      color: var(--white);
      font-weight: 500;
    }

    .blog-body :global(.callout) {
      border-left: 2px solid var(--gold);
      padding: 20px 28px;
      margin: 36px 0;
      background: rgba(201,168,76,0.05);
    }

    .blog-body :global(.callout strong) {
      color: var(--gold);
    }

    .blog-cta {
      max-width: 720px;
      margin: 0 auto;
      padding: 0 48px 100px;
    }

    .blog-cta-inner {
      border: 1px solid var(--border);
      background: var(--surface);
      padding: 48px;
      text-align: center;
    }

    .blog-cta-inner .eyebrow {
      font-family: 'DM Mono', monospace;
      font-size: 11px;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--gold);
      margin-bottom: 16px;
    }

    .blog-cta-inner h2 {
      font-family: 'Cormorant Garamond', serif;
      font-size: 36px;
      font-weight: 600;
      color: var(--white);
      margin-bottom: 14px;
      line-height: 1.15;
    }

    .blog-cta-inner p {
      color: var(--muted);
      margin-bottom: 32px;
      font-size: 15px;
      line-height: 1.7;
      max-width: 420px;
      margin-left: auto;
      margin-right: auto;
      margin-bottom: 32px;
    }

    @media (max-width: 768px) {
      .blog-hero { padding: 120px 24px 60px; }
      .blog-body { padding: 48px 24px 80px; }
      .blog-cta { padding: 0 24px 80px; }
      .blog-cta-inner { padding: 36px 24px; }
    }
  </style>

  <div class="blog-hero">
    <a href="/blog" class="blog-back mono">&larr; All Guides</a>
    <div class="blog-label">{category}</div>
    <h1>{title}</h1>
    <p class="blog-meta">
      Port of Cams Team &nbsp;&middot;&nbsp; <time datetime={publishDate}>{displayDate}</time> &nbsp;&middot;&nbsp; {readingTime} min read
    </p>
  </div>

  <hr class="blog-divider" />

  <div class="blog-body">
    <slot />
  </div>

  {seeItLive.length > 0 && (
    <div class="blog-body" style="margin-top:2rem;">
      <div style="padding:1.25rem 1.5rem;border:1px solid rgba(201,168,76,0.25);border-radius:12px;background:rgba(201,168,76,0.04);">
        <div class="eyebrow" style="margin-bottom:.75rem;">See it live</div>
        <div style="display:grid;gap:.5rem;">
          {seeItLive.map((c) => (
            <a href={`/camera/${c.id}`} style="display:flex;justify-content:space-between;gap:.75rem;align-items:baseline;padding:.6rem .8rem;border-radius:8px;background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.07);text-decoration:none;color:inherit;">
              <span style="font-weight:500;">{c.name}</span>
              <span style="font-size:.8rem;color:var(--muted, #8a8a8e);white-space:nowrap;">{c.location}</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  )}

  <div class="blog-cta">
    <div class="blog-cta-inner">
      <div class="eyebrow">Get Started</div>
      <h2>Put your venue <em style="font-style: italic; color: var(--gold)">on camera</em></h2>
      <p>Set it up yourself for $50/mo, or have us handle the whole thing — pro install, monthly social clips, and salt-air service on the Managed plan for hotels, marinas, and resorts.</p>
      <div style="display:flex; gap:12px; flex-wrap:wrap; justify-content:center;">
        <a href="/host" class="btn-primary">Host a Camera &mdash; $50/mo</a>
        <a href="/managed" class="btn-secondary">Managed for your venue &rarr;</a>
      </div>
    </div>
  </div>
</Layout>
